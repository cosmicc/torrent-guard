# Use host.docker.internal when the apps expose ports on this same Docker server.
# With a shared Docker network you can instead use service DNS names.
QBIT_URL=http://host.docker.internal:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=REPLACE_ME

# These must match the download-client categories configured in the Arr apps.
SONARR_URL=http://host.docker.internal:8989
SONARR_API_KEY=REPLACE_ME
SONARR_CATEGORY=tv-sonarr

RADARR_URL=http://host.docker.internal:7878
RADARR_API_KEY=REPLACE_ME
RADARR_CATEGORY=radarr

# Default is safe report-only mode. Change to false after verifying the logs.
DRY_RUN=true
POLL_SECONDS=5
MAX_AGE_HOURS=24
REJECT_NO_VIDEO=true
STATE_DB=/state/torrent-guard.sqlite3
LOG_LEVEL=INFO
