# The apps run on the same Docker host. Change ports/addresses as needed.
QBIT_URL=http://host.docker.internal:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=REPLACE_ME

# Exact qBittorrent client category configured in each Arr download client.
# The tag is optional but recommended when torrents carry 'tv' / 'movies' tags.
SONARR_URL=http://host.docker.internal:8989
SONARR_API_KEY=REPLACE_ME
SONARR_CATEGORY=tv-sonarr
SONARR_TAG=tv

RADARR_URL=http://host.docker.internal:7878
RADARR_API_KEY=REPLACE_ME
RADARR_CATEGORY=radarr
RADARR_TAG=movies

# For ffprobe, host path that maps to QBIT_DOWNLOAD_ROOT inside qBittorrent.
# EXAMPLE: if qBittorrent sees /downloads and the host sees /srv/media/downloads:
# DOWNLOADS_HOST_PATH=/srv/media/downloads
# QBIT_DOWNLOAD_ROOT=/downloads
# The Compose volume maps this host path to /downloads:ro in Torrent Guard.
DOWNLOADS_HOST_PATH=/EDIT/ME/ACTUAL/DOWNLOADS/HOST/PATH
QBIT_DOWNLOAD_ROOT=/downloads
GUARD_DOWNLOAD_ROOT=/downloads
# qBittorrent's FINAL and TEMPORARY locations (inside the qBittorrent container).
# Keep "Append .!qB extension to incomplete files" ENABLED in qBittorrent.
# Guard examines original file names from API and never ffprobes incomplete files.
QBIT_COMPLETE_DIR=/downloads/complete
QBIT_INCOMPLETE_DIR=/downloads/incomplete
VERIFY_VIDEO_CONTENT=true
FFPROBE_TIMEOUT_SECONDS=30
COMPLETED_SETTLE_SECONDS=60

# Report-only initially. Set false to actually stop, blocklist and delete.
DRY_RUN=true
POLL_SECONDS=5
MAX_AGE_HOURS=24
REJECT_NO_VIDEO=true
IMPORT_GRACE_MINUTES=10
IMPORT_CHECK_SECONDS=60
HISTORY_LOOKBACK_DAYS=30

STATE_DB=/state/torrent-guard.sqlite3
LOG_FILE=/state/torrent-guard.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_LEVEL=INFO
# Console only; persistent audit logs remain plain text. always / auto / never.
LOG_COLOR=always
# Maximum seconds since a completed poll. Increase for large/slow video batches.
# Keep this comfortably above POLL_SECONDS and the longest expected full poll.
HEALTHCHECK_MAX_AGE_SECONDS=300

# Independent file verification is mandatory. Local leftover removal is opt-in
# with compose.cleanup.yaml, which sets CLEANUP_LEFTOVERS=true and adds a write
# mount for the completed directory ONLY. Never use the library or its parent.
CLEANUP_LEFTOVERS=false
DELETE_SETTLE_SECONDS=120
# Set to the host folder corresponding exactly to QBIT_COMPLETE_DIR.
# Example: /mnt/downloads/complete when QBIT_COMPLETE_DIR=/downloads/complete.
CLEANUP_COMPLETE_HOST_PATH=/EDIT/ME/COMPLETED/DOWNLOADS/ONLY
